# Variables de Entorno de Vinaros
# Copia este archivo a .env.production y configúralo según sea necesario.

# Proxy CORS para obtener la cadena de certificados de firma digital
VITE_CORS_PROXY_URL=
VITE_CORS_PROXY_SECRET=

# URLs de Módulos WASM
# Los valores predeterminados preconfigurados habilitan funciones PDF avanzadas de inmediato.
# Para implementaciones sin conexión / aisladas, apunte estos a su servidor interno (ej., /wasm/pymupdf/).
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@vinaros/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@vinaros/gs-wasm/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf/dist/

# Recursos OCR (opcional)
# Establece los tres juntos para OCR autohospedado o sin conexión.
# Deja vacío para usar los valores predeterminados de Tesseract.js.
VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

# Idioma predeterminado de la interfaz (tiempo de compilación)
# Soportados: en, ar, be, fr, de, es, zh, zh-TW, vi, tr, id, it, pt, nl, da, ko, sv, ru
VITE_DEFAULT_LANGUAGE=

# Marca personalizada (tiempo de compilación)
# Reemplaza la marca predeterminada de Vinaros con la tuya.
# Coloca tu archivo de logo en la carpeta public/ y establece la ruta relativa a él.
VITE_BRAND_NAME=
VITE_BRAND_LOGO=
VITE_FOOTER_TEXT=
